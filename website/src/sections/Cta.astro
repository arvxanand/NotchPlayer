import { config } from '../config';
---
<div class="cta-row" data-arch-ok>
  <a class="cta cta-get" href={config.dmgUrl}>{config.ctaLabel}</a>
  <button class="cta cta-share" type="button" data-share>Send this page to your Mac</button>
