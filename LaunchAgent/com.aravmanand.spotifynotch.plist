<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.aravmanand.spotifynotch</string>
	<key>ProgramArguments</key>
	<array>
		<string>__DIR__/SpotifyNotch.app/Contents/MacOS/SpotifyNotch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Interactive, NOT the default Standard and NOT Adaptive.

	     launchd will not work out on its own that a menu-bar app drawing a
	     60Hz waveform is user-interactive software that happens to have no
	     windows. Under the default Standard it is throttled: matchnotch
	     measured 8-13 frames of a 15-frame animation, 25-50fps, from the same
	     binary that gets 55-59fps with this key set. Every animation
	     measurement taken from a terminal-launched build is of a different
	     scheduling class than the app the user actually runs. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<!-- Restart only on a non-zero exit, so quitting deliberately stays quit
	     and the duplicate-instance guard's exit(0) is not respawned into a
	     loop. `launchctl kickstart -k` brings it back. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardErrorPath</key>
	<string>__DIR__/error.log</string>
	<key>StandardOutPath</key>
	<string>__DIR__/out.log</string>
</dict>
</plist>
